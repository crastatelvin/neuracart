# NeuraCart API — copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=8000
DATABASE_URL=postgresql://neuracart:neuracart@localhost:5432/neuracart?schema=public

# JWT — generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-32-byte-random-string
JWT_REFRESH_SECRET=replace-with-another-32-byte-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OTP
OTP_EXPIRES_IN_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
OTP_PEPPER=replace-with-a-32-byte-random-string

# Resend — https://resend.com
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=NeuraCart
SUPPORT_EMAIL=support@neuracart.app

# CORS — comma-separated, no trailing slash
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:8082

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
PUBLIC_API_URL=http://localhost:8000

# Business rules
STORE_TIMEZONE=Asia/Kolkata
DELIVERY_FEE=40
FREE_DELIVERY_ABOVE=500
RIDER_PAYOUT=40
MAX_ACTIVE_ASSIGNMENTS=3
SERVICE_PINCODES=560001,560003,560034,560040,560095
ENABLE_ONLINE_PAYMENTS=false

# Razorpay (v1.1)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Seed guard — production refuses to seed unless this is true
ALLOW_SEED=false

# Observability
SENTRY_DSN=
LOG_LEVEL=debug
