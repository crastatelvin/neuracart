# deps
node_modules/

# env — never commit secrets
.env
.env.local
.env*.local

# builds
dist/
build/
.next/
out/

# expo
.expo/
.expo-shared/
*.jks
*.p8
*.p12
*.key

# runtime output — logs and uploaded product images are never committed,
# but the directories are tracked via .gitkeep so a fresh clone can write to them
backend/logs/*
backend/uploads/*
!backend/logs/.gitkeep
!backend/uploads/.gitkeep

# prisma local dev db
*.db
*.db-journal

# logs / os
*.log
npm-debug.log*
.DS_Store