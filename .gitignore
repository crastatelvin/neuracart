# deps
node_modules/

# env — never commit secrets
.env
.env.local
.env*.local

# builds
dist/
web-build/
build/
.next/
out/

# expo
.expo/
.expo-shared/
expo-env.d.ts
*.tsbuildinfo
.kotlin/
*.orig.*
.metro-health-check*

# generated native dirs (Continuous Native Generation) — never edit or commit by hand
/ios
/android

# signing keys
*.jks
*.p8
*.p12
*.key
*.pem
*.mobileprovision

# backend runtime output — logs and uploaded product images are never committed,
# except the curated demo product photography so a fresh clone renders real images
backend/logs/*
backend/uploads/*
!backend/logs/.gitkeep
!backend/uploads/.gitkeep
!backend/uploads/seed/
!backend/uploads/seed/*.webp

# prisma local dev db
*.db
*.db-journal

# logs / debug / os
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store

# example
example.codegraph/

.codegraph/
