{
  "env": { "browser": true },
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module",
    "ecmaFeatures": { "jsx": true }
  },
  "plugins": ["react-hooks"],
  "rules": {
    "react-hooks/set-state-in-effect": "off",
    "react-hooks/exhaustive-deps": "warn"
  }
}
